{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$username": {
        ".read": true,
        ".write": "auth != null && (( !data.exists() && newData.child('authUid').val() == auth.uid ) || data.child('authUid').val() == auth.uid) && !newData.hasChild('password') && (!data.exists() || newData.child('authUid').val() == data.child('authUid').val())",
        "points": { ".write": false },
        "pointsHistory": { ".write": false },
        "rewardTransactions": { ".write": false },
        "role": { ".write": false },
        "authUid": { ".write": "auth != null && (!data.exists() ? newData.val() == auth.uid : data.val() == auth.uid)" }
      }
    },
    "userByUid": { "$uid": { ".read": "auth != null", ".write": "auth != null && auth.uid == $uid" } },
    "posts": { "$post": { ".read": true, ".write": "auth != null && ((!data.exists() && newData.child('author').val() == root.child('userByUid').child(auth.uid).child('username').val()) || data.child('author').val() == root.child('userByUid').child(auth.uid).child('username').val())" } },
    "communities": { ".read": true, "$id": { ".write": "auth != null && (data.child('admin').val() == root.child('userByUid').child(auth.uid).child('username').val() || (!data.exists() && newData.child('admin').val() == root.child('userByUid').child(auth.uid).child('username').val()))" } },
    "communityPosts": { "$id": { ".read": true, "$post": { ".write": "auth != null && newData.child('author').val() == root.child('userByUid').child(auth.uid).child('username').val()" } } },
    "chats": { "$room": { ".read": "auth != null && $room.matches('.*' + root.child('userByUid').child(auth.uid).child('username').val() + '.*')", ".write": "auth != null && newData.child('sender').val() == root.child('userByUid').child(auth.uid).child('username').val()" } },
    "friendRequests": { "$to": { ".read": "auth != null && $to == root.child('userByUid').child(auth.uid).child('username').val()", "$from": { ".write": "auth != null && ($to == root.child('userByUid').child(auth.uid).child('username').val() || $from == root.child('userByUid').child(auth.uid).child('username').val())" } } },
    "rewardTransactions": { ".read": "auth != null", ".write": false },
    "ads": { "$id": { ".read": true, ".write": "auth != null && ((!data.exists() && newData.child('owner').val() == root.child('userByUid').child(auth.uid).child('username').val()) || data.child('owner').val() == root.child('userByUid').child(auth.uid).child('username').val())" } }
  }
}
